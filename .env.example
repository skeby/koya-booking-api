# MongoDB connection string. Transactions are not required, so a standalone
# mongod works, but Atlas (or scripts/mongo-dev.sh) is the default.
MONGODB_URI=mongodb://127.0.0.1:27017/koya_booking?replicaSet=rs0

# The key every request must send in the X-API-Key header.
API_KEY=change-me

# Comma-separated list of browser origins allowed to call the API. Unset means any origin.
CORS_ORIGIN=

PORT=4000
